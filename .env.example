# Application
APP_NAME=Enterprise AI Workspace
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# Security — change in production
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_MIN_LENGTH=8

# Database
POSTGRES_USER=eaw
POSTGRES_PASSWORD=eaw_secret
POSTGRES_DB=eaw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://eaw:eaw_secret@localhost:5432/eaw

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant (wired in Phase 4)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Object storage: local (default) or s3 (MinIO/AWS)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=data/uploads
MAX_UPLOAD_MB=50
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=eaw-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# OAuth (optional in Phase 2 — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000/api/v1/auth/oauth

# Email (console backend in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@enterprise-ai-workspace.local
EMAIL_BACKEND=console

# Rate limits
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=120

# Phase 4 — RAG indexing
INGESTION_MODE=sync
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
VECTOR_STORE_BACKEND=memory
QDRANT_COLLECTION=eaw_chunks
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CELERY_TASK_ALWAYS_EAGER=false

# Phase 5 — chat / generation
LLM_PROVIDER=echo
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
RAG_TOP_K=20
RAG_RERANK_TOP_N=6
RAG_MIN_SCORE=0.15
RAG_MAX_CONTEXT_CHARS=12000
CHAT_HISTORY_TURNS=8
CHAT_MEMORY_THRESHOLD_MESSAGES=12
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1